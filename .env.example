# Local dev server settings
HOST=127.0.0.1
PORT=3021

# The public repo where issues will be created.
# This should stay the public intake repo, not one of the private app repos.
ISSUE_REPO=deckfamilyfarm/issues

# GitHub token with permission to create issues and labels in ISSUE_REPO.
# Create a fine-grained token or GitHub App token with Issues read/write access and keep it out of git.
GITHUB_TOKEN=

# Secret used to verify GitHub issue_comment webhooks.
GITHUB_WEBHOOK_SECRET=

# Private local storage for reporter email addresses.
DATA_DIR=.data

# Postmark outbound email.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound

# Postmark inbound/reply handling.
# Use the inbound address from Postmark, for example abc123@inbound.postmarkapp.com.
# The app will turn it into abc123+ISSUE_NUMBER@inbound.postmarkapp.com for replies.
POSTMARK_REPLY_TO_EMAIL=

# Add this as ?token=... on the Postmark inbound webhook URL, or send it in
# x-postmark-webhook-secret / x-webhook-secret.
POSTMARK_WEBHOOK_SECRET=

# Staff GitHub author associations whose comments should be emailed to reporters.
EMAIL_ALLOWED_AUTHOR_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR

# Set to 1 for local testing so no GitHub issue is created.
DRY_RUN=1
