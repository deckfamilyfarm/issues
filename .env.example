# Local dev server settings
HOST=127.0.0.1
PORT=3021

# The public repo where issues will be created.
# This should stay the public intake repo, not one of the private app repos.
ISSUE_REPO=deckfamilyfarm/issues

# GitHub token with permission to create issues and labels in ISSUE_REPO.
# Create a fine-grained token or GitHub App token and keep it out of git.
GITHUB_TOKEN=

# Set to 1 for local testing so no GitHub issue is created.
DRY_RUN=1
